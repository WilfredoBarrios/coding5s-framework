# ====================================================================
# Coding5s Official Gitignore Blueprint
# ====================================================================

# --- Microsoft Excel & Office Temp Files ---
~$*.xlsx
~$*.xlsm
~$*.xls
*.tmp
*.bak
.directory

# --- System & Environment Configuration ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Python & Cache Artefacts ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# --- IDEs & Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Framework Generación Local ---
# (Previene que tus pruebas locales inunden el repositorio principal)
/pillar_1/created_courses/*
!/pillar_1/created_courses/.gitkeep

/pillar_3/created_courses/*
!/pillar_3/created_courses/.gitkeep